# Nagrik — Your City. Your Voice.
# Environment Configuration Template
# Copy this file to .env and configure keys as needed. Never commit .env with real secrets.

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Secret key used for signing municipal officer session tokens (HMAC-SHA256)
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ==============================================================================
# Database Configuration
# ==============================================================================
# Default SQLite database path (leave empty for backend/civic_ai.db)
# DATABASE_URL=sqlite:///civic_ai.db

# ==============================================================================
# Groq AI Triage Service
# ==============================================================================
# Official Groq API key (https://console.groq.com)
# If empty or invalid, system automatically uses deterministic rule-based fallback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=8
GROQ_MAX_RETRIES=1

# Backward-compatibility fallback (Google Gemini)
GEMINI_API_KEY=

# ==============================================================================
# Resend Email Integration
# ==============================================================================
# Resend API key for citizen lodging and resolution notifications (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Nagrik Alerts <onboarding@resend.dev>

# Recipient for administrative new-complaint notifications (e.g. municipal duty officer)
# If empty, admin notification is safely logged as 'skipped' without failing complaint creation
ADMIN_NOTIFICATION_EMAIL=

# Optional demo recipient override (all citizen emails redirect here for live demos)
# Required when using Resend's free onboarding@resend.dev sender without a verified custom domain
DEMO_EMAIL_OVERRIDE=

# Optional default recipient for diagnostic testing script (python -m scripts.test_resend)
RESEND_TEST_RECIPIENT=

# ==============================================================================
# n8n Automation Webhook Integration
# ==============================================================================
# Outbound webhook URL in your n8n instance (e.g. https://n8n.yourdomain.com/webhook/nagrik-events)
# If empty, webhook delivery is safely logged as 'skipped' without breaking the app
N8N_WEBHOOK_URL=
# Shared secret for X-Nagrik-Event / Bearer authentication header
N8N_WEBHOOK_SECRET=

# ==============================================================================
# Auto-Assignment Engine Settings
# ==============================================================================
# Minimum triage confidence required to auto-dispatch without supervisor review
ASSIGNMENT_MIN_CONFIDENCE=0.6

# ==============================================================================
# Geospatial & Server Settings
# ==============================================================================
DEFAULT_MAP_CENTER_LAT=28.6139
DEFAULT_MAP_CENTER_LNG=77.2090
FRONTEND_URL=http://localhost:5173
